DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_main_server_id_for_management_commands
BOT_OWNER_ID=your_discord_user_id
# Legacy fallback only. Prefer BOT_OWNER_ID for new deployments.
OWNER_ID=

# Optional: enable AI chat replies when users mention the bot.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
AI_CONVERSATION_PATH=data/aiConversationHistory.json
AI_MEMORY_MAX_TURNS=10
AI_MEMORY_MAX_CONVERSATIONS=500
AI_MEMORY_MAX_BYTES=2000000
AI_MEMORY_MAX_TEXT_LENGTH=2000
AI_MEMORY_RETENTION_DAYS=30
# Existing public/private query memory remains a separate store.
XIAOJI_MEMORY_PATH=data/xiaojiMemory.json

# Required for /weather.
OPENWEATHER_API_KEY=your_openweather_api_key

# Production: configure an independently hosted Lavalink v4 node for /music play.
# Public fallback is disabled by default and must never be treated as production validation.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NODE_NAME=SelfHostedNode
LAVALINK_RECONNECT_TRIES=10
LAVALINK_RECONNECT_INTERVAL_MS=5000
LAVALINK_ALLOW_PUBLIC_FALLBACK=false
# Only read when the explicit opt-in above is true. Supply provider values yourself.
LAVALINK_PUBLIC_FALLBACK_HOST=
LAVALINK_PUBLIC_FALLBACK_PORT=2333
LAVALINK_PUBLIC_FALLBACK_PASSWORD=
LAVALINK_PUBLIC_FALLBACK_SECURE=false
LAVALINK_PUBLIC_FALLBACK_NAME=ExplicitPublicFallback

# Voice stay policy. Guild /music stay overrides this value.
MUSIC_STAY_IN_VOICE=false

# YouTube fallback uses the pinned anonymous bgutil script provider automatically.
# It intentionally accepts no cookie, OAuth, account, manual token, visitor-data, or proxy setting.
# Its short-lived six-hour cache stays under ignored .runtime/ and needs no secret env value.

# One-shot deployment helper for hosts that cannot run npm run deploy separately.
# Set true for one restart, confirm success, then return it to false.
AUTO_DEPLOY_COMMANDS=false

# Optional: 吉幣 SQLite database. Keep this file out of Git.
COIN_DB_PATH=data/xiaoji.sqlite
COIN_TIMEZONE=Asia/Taipei
